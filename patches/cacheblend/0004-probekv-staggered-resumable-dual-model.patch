+        target = torch.as_tensor(target_active_positions, dtype=torch.long,
+                                 device=hidden_states.device)
+        metadata = self.cache_fuse_metadata
+        metadata["active_positions"] = active
+        metadata["target_active_positions"] = target
+        metadata["org_pos"] = torch.arange(
+            metadata["org_seq_len"], dtype=torch.long,
+            device=hidden_states.device)
+        shrinking = not torch.equal(active, target)
+        transition = bool(reuse_commit)
+        status = 1 if transition else (2 if metadata["reuse_active"] else 0)
+        start = torch.cuda.Event(enable_timing=True)
+        end = torch.cuda.Event(enable_timing=True)
+        start.record()
+        hidden_states, residual = self.layers[int(layer) - 1](
+            active, hidden_states, working_kv[int(layer) - 1],
