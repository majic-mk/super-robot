--- a/vllm_blend/vllm/attention/backends/xformers.py
+++ b/vllm_blend/vllm/attention/backends/xformers.py
@@ -205 +205 @@ class XFormersImpl(AttentionImpl):
-            last_len = cache_fuse_metadata['suffix_len']
+            last_len = int(cache_fuse_metadata['suffix_len'])
@@ -207,5 +207,27 @@ class XFormersImpl(AttentionImpl):
-            last_indices = [total_len-last_len+l for l in range(last_len)]
-
-            topk_num = int((total_len-last_len)*cache_fuse_metadata["recomp_ratio"])
-            temp_diff = torch.sum((value[:-last_len,:,:]-value_old[:-last_len,:,:])**2, dim=[1,2])
-            top_indices = torch.topk(temp_diff, k=topk_num).indices
+            segment_start = int(cache_fuse_metadata['segment_start'])
+            segment_len = int(cache_fuse_metadata['segment_len'])
+            segment_end = segment_start + segment_len
+            suffix_start = total_len - last_len
+            if segment_len <= 0:
+                raise ValueError("segment_len must be positive")
+            if segment_start < 0 or segment_end != suffix_start:
+                raise ValueError("P/C/S metadata does not cover the prompt")
+            ratio = float(cache_fuse_metadata["recomp_ratio"])
+            if ratio < 0.0 or ratio > 1.0:
+                raise ValueError("recomp_ratio must be in [0, 1]")
+            if ratio == 0.0:
+                topk_num = 0
+            elif ratio == 1.0:
+                topk_num = segment_len
+            else:
+                topk_num = int(segment_len * ratio)
+            temp_diff = torch.sum(
+                (
+                    value[segment_start:segment_end, :, :]
+                    - value_old[segment_start:segment_end, :, :]
+                ) ** 2,
+                dim=[1, 2],
+            )
+            ranking = torch.argsort(
+                temp_diff, descending=True, stable=True
+            )
@@ -213,3 +235,14 @@ class XFormersImpl(AttentionImpl):
-            top_indices, _ = torch.sort(top_indices)
-            top_indices = torch.cat([top_indices,
-                                        torch.tensor(last_indices, device=top_indices.device)])
+            segment_indices = ranking[:topk_num] + segment_start
+            segment_indices, _ = torch.sort(segment_indices)
+            suffix_indices = torch.arange(
+                suffix_start,
+                total_len,
+                dtype=torch.long,
+                device=segment_indices.device,
+            )
+            top_indices = torch.cat([segment_indices, suffix_indices])
+            cache_fuse_metadata["eligible_segment_tokens"] = segment_len
+            cache_fuse_metadata["selected_segment_tokens"] = topk_num
+            cache_fuse_metadata["effective_ratio"] = topk_num / float(segment_len)
+            cache_fuse_metadata["mandatory_suffix_tokens"] = last_len
+            cache_fuse_metadata["selected_segment_indices"] = segment_indices
@@ -219,2 +252,8 @@ class XFormersImpl(AttentionImpl):
-            #attn_bias = _make_partial_bias_gqa(cache_fuse_metadata, query.device, self.num_kv_heads, self.num_queries_per_kv)
-            attn_bias = LowerTriangularFromBottomRightMask()
+            # Repaired C queries are arbitrary absolute rows, followed by the
+            # mandatory dense suffix. Bottom-right masking is not equivalent.
+            attn_bias = _make_partial_bias_gqa(
