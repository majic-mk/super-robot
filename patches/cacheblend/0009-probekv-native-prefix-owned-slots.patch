+def _probekv_owned_cache_rows(key, value, metadata, fuse):
+    # Composite KV spans the full request; native slots span only the
+    # uncomputed suffix. Never write shared exact Prefix blocks back.
+    prefix = int(fuse.get("exact_prefix_tokens", 0))
+    total = int(fuse["org_seq_len"])
+    if not 0 <= prefix < total:
+        raise ValueError("invalid exact Prefix extent")
+    if key.shape[0] != total or value.shape[0] != total:
+        raise ValueError("resumable KV must cover the complete request")
+    if metadata.num_decode_tokens != 0:
+        raise ValueError("resumable prefill cannot mix native decode rows")
+    if metadata.slot_mapping.numel() != total - prefix:
+        raise ValueError("native slot count differs from owned KV rows")
+    if metadata.num_prefill_tokens != total - prefix:
+        raise ValueError("native prefill extent differs from owned KV rows")
+    return key[prefix:], value[prefix:]
+
